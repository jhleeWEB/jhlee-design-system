{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/npm", { "pkgRoot": "packages/ui", "npmPublish": false }],
    [
      "@semantic-release/exec",
      {
        "publishCmd": "pnpm --filter @jhleeweb/squircle-design-system publish --no-git-checks --access restricted"
      }
    ],
    "@semantic-release/github"
  ]
}
