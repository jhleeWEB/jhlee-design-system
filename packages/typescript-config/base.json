// 네 앱이 **합의하는 것만** 여기 둔다. 엄격도는 앱마다 다르고, 그 차이는 의도된
// 것이다 — 구 aaro-kaufland-prototype은 57k LOC를 느슨한 설정으로 키워왔고,
// DataCenter·FulfillmentCenter는 처음부터 noUncheckedIndexedAccess·
// verbatimModuleSyntax를 켜고 시작했다. 공통 base에 엄격 옵션을 올리면 kaufland가
// 타입 에러 수백 개로 터진다. 그래서 base는 교집합이고, 각 앱 tsconfig가 자기
// 엄격도를 더한다. 새 패키지는 엄격한 쪽(DC·FC 프로필)을 기본으로 쓴다.
//
// `lib`은 ESNext다 — 셋 중 kaufland만 esnext를 쓰고 나머지는 ES2022로 좁힌다.
// base를 ES2022로 두면 kaufland의 최신 API 사용이 조용히 깨질 수 있으므로 넓은
// 쪽을 base에 두고, 좁히는 앱이 자기 tsconfig에서 좁힌다. 결과적으로 세 앱의
// 현재 동작이 그대로 보존된다.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
