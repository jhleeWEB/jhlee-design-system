{
  "$description": "층위 — radius · shadow 사다리. shipped 캔버스 툴(tldraw)의 라이브 DOM 값을 이 제품의 밀도로 누른 것(theme.css 주석). z-index · corner 는 B4. reset 은 Tailwind 기본 사다리를 지워 역할 이름만 남긴다.",
  "$extensions": { "sds": { "scope": "theme" } },
  "radius": {
    "$type": "dimension",
    "$extensions": { "sds": { "reset": true } },
    "none": { "$value": "0", "$description": "캔버스 · 도면 요소 · 표 셀." },
    "chip": { "$value": "6px", "$description": "배지 · 칩 · 스켈레톤 바." },
    "control": { "$value": "8px", "$description": "버튼 · 입력 · 셀렉트 — 잡는 것." },
    "card": { "$value": "12px", "$description": "떠 있는 패널 — 이 제품의 기본 구획." },
    "float": { "$value": "12px", "$description": "팝오버 · 툴팁 · 토스트 · 드롭다운." },
    "modal": { "$value": "16px", "$description": "모달 · 서랍 — 화면을 가리는 것." },
    "full": { "$value": "9999px", "$description": "스위치 손잡이 · 상태 점 · pill 토글." }
  },
  "shadow": {
    "$type": "shadow",
    "$extensions": { "sds": { "reset": true } },
    "none": { "$value": "none" },
    "chip": { "$value": "0 1px 2px rgb(25 31 40 / 0.05)" },
    "card": { "$value": "0 1px 2px rgb(25 31 40 / 0.04), 0 4px 12px rgb(25 31 40 / 0.05)" },
    "pop": { "$value": "0 2px 6px rgb(25 31 40 / 0.06), 0 12px 28px rgb(25 31 40 / 0.10), 0 0 0 1px rgb(25 31 40 / 0.05)", "$description": "3·4단은 inset 헤어라인을 그림자 안에 넣는다 — 부유 레이어가 테두리를 따로 그리지 않게." },
    "modal": { "$value": "0 8px 20px rgb(25 31 40 / 0.10), 0 28px 64px rgb(25 31 40 / 0.16), 0 0 0 1px rgb(25 31 40 / 0.05)" }
  }
}
