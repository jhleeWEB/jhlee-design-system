{
  "$description": "크롬 — UI 가 사는 면, 라이트 기준값. 판정 3색은 톤마다 다섯 역할(DEFAULT · hover · ink · soft · line)을 원시 사다리에서 고른다(#18) — 역할의 뜻과 대비 근거는 primitive/color.json 의 각 단에 있다. accent-ink · overlay · selection-fill · scrim 넷은 아직 리터럴이다.",
  "$extensions": { "sds": { "scope": "chrome" } },
  "chrome": {
    "$type": "color",
    "bg": { "$value": "{palette.cool.100}", "$description": "페이지 바닥 — 카드가 여기 떠 있다." },
    "surface": { "$value": "{palette.cool.0}" },
    "surface-2": { "$value": "{palette.cool.25}", "$description": "카드 안에서 한 단 들어간 칸(캔버스 웰 · 입력)." },
    "surface-3": { "$value": "{palette.cool.150}", "$description": "눌린 상태 · 선택된 행 · 레일 바닥 · 상태바." },
    "overlay": { "$value": "rgb(255 255 255 / 0.94)", "$description": "캔버스 위에 반투명하게 얹는 패널." },
    "ink": { "$value": "{palette.cool.900}" },
    "ink-2": { "$value": "{palette.cool.600}" },
    "muted": { "$value": "{palette.cool.500}" },
    "disabled": { "$value": "{palette.cool.400}" },
    "line": { "$value": "{palette.cool.200}" },
    "line-strong": { "$value": "{palette.cool.300}" },
    "accent": { "$value": "{palette.azure.500}", "$description": "유채색 액센트 — «지금 고른 것 · 주된 동작». 판정 3색과 뜻이 갈린다." },
    "accent-hover": { "$value": "{palette.azure.600}" },
    "accent-ink": { "$value": "#ffffff" },
    "accent-soft": { "$value": "{palette.azure.50}" },
    "accent-track": { "$value": "{palette.azure.100}" },
    "selection-fill": { "$value": "rgb(8 105 225 / 0.14)" },
    "selection-stroke": { "$value": "{palette.azure.500}" },
    "scrim": { "$value": "rgb(15 19 26 / 0.38)" },
    "focus": { "$value": "{palette.azure.500}" },
    "tooltip-bg": { "$value": "{palette.cool.900}", "$description": "툴팁만 면을 뒤집는다 — «일시적이고 내 것이 아니다»." },
    "tooltip-ink": { "$value": "{palette.cool.25}" },
    "ok": { "$value": "{palette.moss.500}", "$description": "판정 «통과» — 채움(solid) · 글자(text)." },
    "ok-hover": { "$value": "{palette.moss.700}", "$description": "solid 의 hover — 글자(ink) 대비가 4.5:1 위에 남도록 어둡힌다." },
    "ok-ink": { "$value": "{palette.cool.0}", "$description": "solid 위의 글자 — 흰색 4.78:1." },
    "ok-soft": { "$value": "{palette.moss.50}", "$description": "옅은 면 — 배지 · 알림 바탕." },
    "ok-line": { "$value": "{palette.moss.400}", "$description": "테두리 — 면 위 3:1(비텍스트 경계). 옛 border-ok/35 · /40 혼용을 이것 하나로." },
    "warn": { "$value": "{palette.amber.500}" },
    "warn-hover": { "$value": "{palette.amber.600}" },
    "warn-ink": { "$value": "{palette.cool.950}", "$description": "amber 위의 흰 글자는 3.79:1 — 어두운 글자(4.91:1)만 4.5 를 넘는다." },
    "warn-soft": { "$value": "{palette.amber.50}" },
    "warn-line": { "$value": "{palette.amber.400}" },
    "danger": { "$value": "{palette.rust.500}" },
    "danger-hover": { "$value": "{palette.rust.700}" },
    "danger-ink": { "$value": "{palette.cool.0}", "$description": "흰색 5.18:1." },
    "danger-soft": { "$value": "{palette.rust.50}" },
    "danger-line": { "$value": "{palette.rust.300}" }
  }
}
