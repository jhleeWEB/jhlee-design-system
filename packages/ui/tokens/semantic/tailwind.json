{
  "$description": "Tailwind @theme inline 매핑 — 모드가 갈리는 값은 반드시 var(--chrome-*|--canvas-*) 참조(혼용 규칙 ④). 리터럴 넷(transparent · current · white · black)은 references.spec 의 KNOWN_INLINE_LITERALS 와 같고 Phase B 가 지운다. 이름은 오늘의 이례(--color-chrome ← chrome.bg · --color-tooltip ← chrome.tooltip-bg)를 그대로 적는다 — 기계적 대응은 B5.",
  "$extensions": { "sds": { "scope": "theme-inline" } },
  "color": {
    "$type": "color",
    "$extensions": { "sds": { "reset": true } },
    "transparent": { "$value": "transparent" },
    "current": { "$value": "currentColor" },
    "white": { "$value": "#ffffff" },
    "black": { "$value": "#1a1a1a" },
    "canvas": { "$value": "{canvas.bg}" },
    "canvas-surface": { "$value": "{canvas.surface}" },
    "canvas-line": { "$value": "{canvas.line}" },
    "canvas-line-strong": { "$value": "{canvas.line-strong}" },
    "canvas-ink": { "$value": "{canvas.ink}" },
    "canvas-ink-2": { "$value": "{canvas.ink-2}" },
    "canvas-muted": { "$value": "{canvas.muted}" },
    "canvas-grid": { "$value": "{canvas.grid}" },
    "chrome": { "$value": "{chrome.bg}" },
    "surface": { "$value": "{chrome.surface}" },
    "surface-2": { "$value": "{chrome.surface-2}" },
    "surface-3": { "$value": "{chrome.surface-3}" },
    "overlay": { "$value": "{chrome.overlay}" },
    "ink": { "$value": "{chrome.ink}" },
    "ink-2": { "$value": "{chrome.ink-2}" },
    "muted": { "$value": "{chrome.muted}" },
    "disabled": { "$value": "{chrome.disabled}" },
    "line": { "$value": "{chrome.line}" },
    "line-strong": { "$value": "{chrome.line-strong}" },
    "accent": { "$value": "{chrome.accent}" },
    "accent-hover": { "$value": "{chrome.accent-hover}" },
    "accent-ink": { "$value": "{chrome.accent-ink}" },
    "accent-soft": { "$value": "{chrome.accent-soft}" },
    "accent-track": { "$value": "{chrome.accent-track}" },
    "selection-fill": { "$value": "{chrome.selection-fill}" },
    "selection-stroke": { "$value": "{chrome.selection-stroke}" },
    "scrim": { "$value": "{chrome.scrim}" },
    "focus": { "$value": "{chrome.focus}" },
    "tooltip": { "$value": "{chrome.tooltip-bg}" },
    "tooltip-ink": { "$value": "{chrome.tooltip-ink}" },
    "ok": { "$value": "{chrome.ok}" },
    "warn": { "$value": "{chrome.warn}" },
    "danger": { "$value": "{chrome.danger}" },
    "ok-soft": { "$value": "{chrome.ok-soft}" },
    "warn-soft": { "$value": "{chrome.warn-soft}" },
    "danger-soft": { "$value": "{chrome.danger-soft}" }
  },
  "font": {
    "$type": "fontFamily",
    "$description": "Instrument Sans(제목에서 성격이 나오고 13px 본문에서 버틴다) · Geist Mono(tabular 기본). 한글 폴백은 base 의 스택을 잇는다.",
    "sans": { "$value": "\"Instrument Sans\", {sans}" },
    "mono": { "$value": "\"Geist Mono\", {mono}" }
  }
}
