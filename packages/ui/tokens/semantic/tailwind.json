{
  "$description": "Tailwind @theme inline 매핑 — 모드가 갈리는 값은 반드시 var(--chrome-*|--canvas-*) 참조(혼용 규칙 ④). 리터럴은 0 이다(#18): white·black 은 모드와 무관하게 고정인 캔버스 흰색·잉크를 가리키고, transparent·current 는 Tailwind 4 가 --color-* 없이도 내는 키워드라(bg-transparent · text-current, 컴파일 실측) 적지 않는다. 이름은 chrome.* 의 `chrome-` 접두만 뗀 기계적 대응이다(B5 #22) — 예외는 input(shadcn 의 --input, border 와 같은 값)뿐이다. 옛 유틸 이름(text-ink · bg-surface …)의 alias 는 3.0.0 에서 지웠다(#49) — 린트 --fix 가 옮긴다.",
  "$extensions": { "sds": { "scope": "theme-inline" } },
  "color": {
    "$type": "color",
    "$extensions": { "sds": { "reset": true } },
    "white": {
      "$value": "{canvas.bg}",
      "$description": "모드와 무관한 흰색 — 다크에서도 희어야 하는 자리. 캔버스 흰색과 같은 고정값이다."
    },
    "black": { "$value": "{canvas.ink}", "$description": "모드와 무관한 검정 — 캔버스 잉크와 같은 고정값." },
    "canvas": { "$value": "{canvas.bg}" },
    "canvas-surface": { "$value": "{canvas.surface}" },
    "canvas-line": { "$value": "{canvas.line}" },
    "canvas-line-strong": { "$value": "{canvas.line-strong}" },
    "canvas-ink": { "$value": "{canvas.ink}" },
    "canvas-ink-2": { "$value": "{canvas.ink-2}" },
    "canvas-muted": { "$value": "{canvas.muted}" },
    "canvas-grid": { "$value": "{canvas.grid}" },
    "background": { "$value": "{chrome.background}" },
    "card": { "$value": "{chrome.card}" },
    "muted": { "$value": "{chrome.muted}" },
    "secondary": { "$value": "{chrome.secondary}" },
    "popover": { "$value": "{chrome.popover}" },
    "foreground": { "$value": "{chrome.foreground}" },
    "foreground-2": { "$value": "{chrome.foreground-2}" },
    "muted-foreground": { "$value": "{chrome.muted-foreground}" },
    "foreground-disabled": { "$value": "{chrome.foreground-disabled}" },
    "border": { "$value": "{chrome.border}" },
    "input": {
      "$value": "{chrome.border}",
      "$description": "shadcn 의 --input — 입력 테두리. 이 시스템은 border 와 같은 값이라 chrome 토큰을 따로 두지 않는다."
    },
    "border-strong": { "$value": "{chrome.border-strong}" },
    "primary": { "$value": "{chrome.primary}" },
    "primary-hover": { "$value": "{chrome.primary-hover}" },
    "primary-foreground": { "$value": "{chrome.primary-foreground}" },
    "primary-track": { "$value": "{chrome.primary-track}" },
    "primary-line": { "$value": "{chrome.primary-line}" },
    "accent": { "$value": "{chrome.accent}" },
    "accent-foreground": { "$value": "{chrome.accent-foreground}" },
    "selection-fill": { "$value": "{chrome.selection-fill}" },
    "selection-stroke": { "$value": "{chrome.selection-stroke}" },
    "scrim": { "$value": "{chrome.scrim}" },
    "ring": { "$value": "{chrome.ring}" },
    "tooltip": { "$value": "{chrome.tooltip}" },
    "tooltip-foreground": { "$value": "{chrome.tooltip-foreground}" },
    "success": { "$value": "{chrome.success}" },
    "success-hover": { "$value": "{chrome.success-hover}" },
    "success-foreground": { "$value": "{chrome.success-foreground}" },
    "success-soft": { "$value": "{chrome.success-soft}" },
    "success-line": { "$value": "{chrome.success-line}" },
    "warning": { "$value": "{chrome.warning}" },
    "warning-hover": { "$value": "{chrome.warning-hover}" },
    "warning-foreground": { "$value": "{chrome.warning-foreground}" },
    "warning-soft": { "$value": "{chrome.warning-soft}" },
    "warning-line": { "$value": "{chrome.warning-line}" },
    "destructive": { "$value": "{chrome.destructive}" },
    "destructive-hover": { "$value": "{chrome.destructive-hover}" },
    "destructive-foreground": { "$value": "{chrome.destructive-foreground}" },
    "destructive-soft": { "$value": "{chrome.destructive-soft}" },
    "destructive-line": { "$value": "{chrome.destructive-line}" },
    "info": { "$value": "{chrome.info}" },
    "info-hover": { "$value": "{chrome.info-hover}" },
    "info-foreground": { "$value": "{chrome.info-foreground}" },
    "info-soft": { "$value": "{chrome.info-soft}" },
    "info-line": { "$value": "{chrome.info-line}" }
  },
  "font": {
    "$type": "fontFamily",
    "$description": "Instrument Sans(제목에서 성격이 나오고 13px 본문에서 버틴다) · Geist Mono(tabular 기본) — 스택은 --font-stack-* 하나를 그대로 가리킨다. body · tnum · .num 이 같은 스택을 읽어 font-sans 를 들지 않은 컴포넌트도 같은 글꼴이다(#80).",
    "sans": { "$value": "{font-stack.sans}" },
    "mono": { "$value": "{font-stack.mono}" }
  }
}
