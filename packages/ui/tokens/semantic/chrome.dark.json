{
  "$description": "크롬 다크 — 생성기가 한 번 읽어 @media (prefers-color-scheme: dark) 블록과 [data-theme=dark] 블록에 같은 본문을 찍는다(손 CSS 의 복붙 두 블록을 대체). 오늘은 raw hex — 새 원시 사다리 참조는 B4.",
  "$extensions": { "sds": { "scope": "chrome" } },
  "chrome": {
    "$type": "color",
    "bg": { "$value": "#0e1116" },
    "surface": { "$value": "#161a21" },
    "surface-2": { "$value": "#1c212a" },
    "surface-3": { "$value": "#252b36" },
    "overlay": { "$value": "rgb(22 26 33 / 0.94)" },
    "ink": { "$value": "#eaedf3" },
    "ink-2": { "$value": "#b3bac6" },
    "muted": { "$value": "#8a93a3" },
    "disabled": { "$value": "#5b6474" },
    "line": { "$value": "#242a34" },
    "line-strong": { "$value": "#333b48" },
    "accent": { "$value": "#4d9bff" },
    "accent-hover": { "$value": "#6fb0ff" },
    "accent-ink": { "$value": "#061018" },
    "accent-soft": { "$value": "#14243a" },
    "accent-track": { "$value": "#1a2b42" },
    "selection-fill": { "$value": "rgb(77 155 255 / 0.20)" },
    "selection-stroke": { "$value": "#4d9bff" },
    "scrim": { "$value": "rgb(0 0 0 / 0.60)" },
    "focus": { "$value": "#6fb0ff" },
    "tooltip-bg": { "$value": "#eaedf3" },
    "tooltip-ink": { "$value": "#0e1116" },
    "ok": { "$value": "#4cb37e" },
    "warn": { "$value": "#d99c3d" },
    "danger": { "$value": "#e2764d" },
    "ok-soft": { "$value": "#12261c" },
    "warn-soft": { "$value": "#2a2113" },
    "danger-soft": { "$value": "#2b1913" }
  }
}
