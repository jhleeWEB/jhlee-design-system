{
  "$description": "크롬 다크 — 생성기가 한 번 읽어 @media (prefers-color-scheme: dark) 블록과 [data-theme=dark] 블록에 같은 본문을 찍는다. 판정 3색은 원시 사다리 참조(값은 옛 다크 hex 그대로), 뉴트럴·액센트는 아직 raw hex 다. 다크에서는 세 톤 모두 solid 위 흰 글자가 4.5:1 을 못 넘어 ink 가 cool.950 이고 hover 는 밝아진다(#18).",
  "$extensions": { "sds": { "scope": "chrome" } },
  "chrome": {
    "$type": "color",
    "bg": { "$value": "#0e1116" },
    "surface": { "$value": "#161a21" },
    "surface-2": { "$value": "#1c212a" },
    "surface-3": { "$value": "#252b36" },
    "overlay": { "$value": "rgb(22 26 33 / 0.94)" },
    "ink": { "$value": "#eaedf3" },
    "ink-2": { "$value": "#b3bac6" },
    "muted": { "$value": "#8a93a3" },
    "disabled": { "$value": "#5b6474" },
    "line": { "$value": "#242a34" },
    "line-strong": { "$value": "#333b48" },
    "accent": { "$value": "#4d9bff" },
    "accent-hover": { "$value": "#6fb0ff" },
    "accent-ink": { "$value": "#061018" },
    "accent-soft": { "$value": "#14243a" },
    "accent-track": { "$value": "#1a2b42" },
    "selection-fill": { "$value": "rgb(77 155 255 / 0.20)" },
    "selection-stroke": { "$value": "#4d9bff" },
    "scrim": { "$value": "rgb(0 0 0 / 0.60)" },
    "focus": { "$value": "#6fb0ff" },
    "tooltip-bg": { "$value": "#eaedf3" },
    "tooltip-ink": { "$value": "#0e1116" },
    "ok": { "$value": "{palette.moss.300}" },
    "ok-hover": { "$value": "{palette.moss.200}" },
    "ok-ink": { "$value": "{palette.cool.950}" },
    "ok-soft": { "$value": "{palette.moss.900}" },
    "ok-line": { "$value": "{palette.moss.600}" },
    "warn": { "$value": "{palette.amber.300}" },
    "warn-hover": { "$value": "{palette.amber.200}" },
    "warn-ink": { "$value": "{palette.cool.950}" },
    "warn-soft": { "$value": "{palette.amber.900}" },
    "warn-line": { "$value": "{palette.amber.700}" },
    "danger": { "$value": "{palette.rust.400}" },
    "danger-hover": { "$value": "{palette.rust.200}" },
    "danger-ink": { "$value": "{palette.cool.950}" },
    "danger-soft": { "$value": "{palette.rust.900}" },
    "danger-line": { "$value": "{palette.rust.600}" }
  }
}
