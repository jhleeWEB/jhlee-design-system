{
  "$description": "옛 이름 — 소비자 계약이라 이름은 지키고 값은 새 정본을 가리키는 alias 로만 남는다(계획 §2.2 «alias 이행», #18). 값은 옛 tokens.css·theme.css 와 같다 — alias 가 픽셀을 바꾸면 그것은 이행이 아니라 회귀다. 그래서 --ink 는 --chrome-ink(#191f28)가 아니라 같은 값(#1a1a1a)의 palette.gray.900 을 가리킨다. 여기 있는 이름을 패키지 소스가 쓰면 forbidden-patterns 의 legacy-alias-use 래칫에 잡힌다. 제거는 major.",
  "$extensions": { "sds": { "scope": "legacy" } },
  "$deprecated": "옛 base 이름. 제거는 major.",
  "black": { "$type": "color", "$value": "{palette.gray.900}", "$deprecated": "palette.gray.900 — 도면 잉크는 canvas.ink." },
  "dark": { "$type": "color", "$value": "{palette.gray.800}", "$deprecated": "palette.gray.800." },
  "charcoal": { "$type": "color", "$value": "{palette.gray.700}", "$deprecated": "palette.gray.700 — 도면은 canvas.ink-2." },
  "mid": { "$type": "color", "$value": "{palette.gray.600}", "$deprecated": "palette.gray.600 — 도면은 canvas.muted." },
  "steel": { "$type": "color", "$value": "{palette.gray.500}", "$deprecated": "palette.gray.500." },
  "silver": { "$type": "color", "$value": "{palette.gray.400}", "$deprecated": "palette.gray.400." },
  "light": { "$type": "color", "$value": "{palette.gray.250}", "$deprecated": "palette.gray.250." },
  "pale": { "$type": "color", "$value": "{palette.gray.150}", "$deprecated": "palette.gray.150 — 도면 격자는 canvas.grid." },
  "offwhite": { "$type": "color", "$value": "{palette.gray.100}", "$deprecated": "palette.gray.100." },
  "white": { "$type": "color", "$value": "{palette.gray.0}", "$deprecated": "palette.gray.0 — 도면 바탕은 canvas.bg, 크롬 카드는 chrome.surface." },
  "ink": { "$type": "color", "$value": "{palette.gray.900}", "$deprecated": "크롬 글자는 chrome.ink(#191f28 — 값이 다르다), 도면 글자는 canvas.ink." },
  "ink-2": { "$type": "color", "$value": "{palette.gray.700}", "$deprecated": "chrome.ink-2 또는 canvas.ink-2." },
  "muted": { "$type": "color", "$value": "{palette.gray.600}", "$deprecated": "chrome.muted 또는 canvas.muted." },
  "line": { "$type": "color", "$value": "{palette.gray.200}", "$deprecated": "chrome.line 또는 canvas.line." },
  "line-strong": { "$type": "color", "$value": "{palette.gray.300}", "$deprecated": "chrome.line-strong 또는 canvas.line-strong." },
  "bg": { "$type": "color", "$value": "{palette.gray.100}", "$deprecated": "페이지 바닥은 chrome.bg(#eff1f7 — 값이 다르다)." },
  "surface": { "$type": "color", "$value": "{palette.gray.0}", "$deprecated": "chrome.surface 또는 canvas.bg." },
  "surface-2": { "$type": "color", "$value": "{palette.gray.50}", "$deprecated": "chrome.surface-2(#f9fbfc — 값이 다르다) 또는 canvas.surface." },
  "ok": { "$type": "color", "$value": "{palette.moss.500}", "$deprecated": "chrome.ok." },
  "warn": { "$type": "color", "$value": "{palette.amber.500}", "$deprecated": "chrome.warn." },
  "danger": { "$type": "color", "$value": "{palette.rust.500}", "$deprecated": "chrome.danger." },
  "ok-pale": { "$type": "color", "$value": "{palette.moss.50}", "$deprecated": "chrome.ok-soft." },
  "warn-pale": { "$type": "color", "$value": "{palette.amber.50}", "$deprecated": "chrome.warn-soft." },
  "danger-pale": { "$type": "color", "$value": "{palette.rust.50}", "$deprecated": "chrome.danger-soft." },
  "panel-w": { "$type": "dimension", "$value": "300px", "$deprecated": "legacy shell.css 의 3열 셸 전용 — 새 이름 없음." },
  "inspect-w": { "$type": "dimension", "$value": "340px", "$deprecated": "legacy shell.css 의 3열 셸 전용 — 새 이름 없음." },
  "topbar-h": { "$type": "dimension", "$value": "56px", "$deprecated": "legacy shell.css 의 3열 셸 전용 — 새 이름 없음." },
  "gap": { "$type": "dimension", "$value": "{space.hairline}", "$deprecated": "space.hairline." },
  "sans": { "$type": "fontFamily", "$value": "{font-stack.sans}", "$deprecated": "font-stack.sans(폴백 스택) 또는 Tailwind font-sans." },
  "mono": { "$type": "fontFamily", "$value": "{font-stack.mono}", "$deprecated": "font-stack.mono(폴백 스택) 또는 Tailwind font-mono." },
  "size": {
    "$type": "dimension",
    "gap": { "$value": "{space.card-gap}", "$deprecated": "space.card-gap — gap-shell 유틸리티가 아직 이것을 읽는다." }
  },
  "color": {
    "$type": "color",
    "$description": "옛 원시 이름 --color-{hue}-{step} → --palette-*. Tailwind 의 --color-* 네임스페이스와 겹쳐 개명했다.",
    "$deprecated": "palette.* 를 쓴다.",
    "cool": {
      "0": { "$value": "{palette.cool.0}" },
      "25": { "$value": "{palette.cool.25}" },
      "50": { "$value": "{palette.cool.50}" },
      "100": { "$value": "{palette.cool.100}" },
      "150": { "$value": "{palette.cool.150}" },
      "200": { "$value": "{palette.cool.200}" },
      "300": { "$value": "{palette.cool.300}" },
      "400": { "$value": "{palette.cool.400}" },
      "500": { "$value": "{palette.cool.500}" },
      "600": { "$value": "{palette.cool.600}" },
      "700": { "$value": "{palette.cool.700}" },
      "800": { "$value": "{palette.cool.800}" },
      "900": { "$value": "{palette.cool.900}" },
      "950": { "$value": "{palette.cool.950}" }
    },
    "azure": {
      "50": { "$value": "{palette.azure.50}" },
      "100": { "$value": "{palette.azure.100}" },
      "200": { "$value": "{palette.azure.200}" },
      "500": { "$value": "{palette.azure.500}" },
      "600": { "$value": "{palette.azure.600}" },
      "700": { "$value": "{palette.azure.700}" }
    },
    "mono": {
      "0": { "$value": "{palette.mono.0}" },
      "50": { "$value": "{palette.mono.50}" },
      "100": { "$value": "{palette.mono.100}" },
      "200": { "$value": "{palette.mono.200}" },
      "300": { "$value": "{palette.mono.300}" },
      "400": { "$value": "{palette.mono.400}" },
      "500": { "$value": "{palette.mono.500}" },
      "600": { "$value": "{palette.mono.600}" },
      "700": { "$value": "{palette.mono.700}" },
      "800": { "$value": "{palette.mono.800}" },
      "900": { "$value": "{palette.mono.900}" },
      "950": { "$value": "{palette.mono.950}" }
    }
  }
}
