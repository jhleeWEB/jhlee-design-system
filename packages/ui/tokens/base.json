{
  "$description": "tokens.css 의 base 층 — 회색조 10단 · 시맨틱 8 · 판정 6 · 셸 치수 4 · 글꼴 스택 2. 이름은 소비자 계약이라 이번엔 그대로 둔다(#15). B4 가 legacy.json 으로 옮겨 새 이름의 $deprecated alias 로 만든다.",
  "$extensions": { "sds": { "scope": "root" } },
  "black": { "$type": "color", "$value": "#1a1a1a" },
  "dark": { "$type": "color", "$value": "#2a2a2a" },
  "charcoal": { "$type": "color", "$value": "#3a3a3a" },
  "mid": { "$type": "color", "$value": "#6b6b6b" },
  "steel": { "$type": "color", "$value": "#8a8a8a" },
  "silver": { "$type": "color", "$value": "#ababab" },
  "light": { "$type": "color", "$value": "#d5d5d5" },
  "pale": { "$type": "color", "$value": "#ebebeb" },
  "offwhite": { "$type": "color", "$value": "#f4f4f4" },
  "white": { "$type": "color", "$value": "#ffffff" },
  "ink": { "$type": "color", "$value": "{black}" },
  "ink-2": { "$type": "color", "$value": "{charcoal}" },
  "muted": { "$type": "color", "$value": "{mid}" },
  "line": { "$type": "color", "$value": "#dcdcdc" },
  "line-strong": { "$type": "color", "$value": "#bfbfbf" },
  "bg": { "$type": "color", "$value": "{offwhite}" },
  "surface": { "$type": "color", "$value": "{white}" },
  "surface-2": { "$type": "color", "$value": "#fafafa" },
  "ok": { "$type": "color", "$value": "#17834d" },
  "warn": { "$type": "color", "$value": "#b87409" },
  "danger": { "$type": "color", "$value": "#c2410c" },
  "ok-pale": { "$type": "color", "$value": "#e9f4ee" },
  "warn-pale": { "$type": "color", "$value": "#fdf3e2" },
  "danger-pale": { "$type": "color", "$value": "#fbeae3" },
  "panel-w": { "$type": "dimension", "$value": "300px" },
  "inspect-w": { "$type": "dimension", "$value": "340px" },
  "topbar-h": { "$type": "dimension", "$value": "56px" },
  "gap": { "$type": "dimension", "$value": "1px", "$description": "패널 사이는 헤어라인 하나 — 여백이 아니라 선이 구조를 만든다." },
  "sans": { "$type": "fontFamily", "$value": "\"Noto Sans KR\", Pretendard, \"Apple SD Gothic Neo\", system-ui, -apple-system, sans-serif" },
  "mono": { "$type": "fontFamily", "$value": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Consolas, monospace" }
}
