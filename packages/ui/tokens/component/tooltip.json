{
  "$description": "툴팁 지연 — Radix delayDuration 기본값. CSS 와 TS(MOTION.tooltipDelayMs) 둘 다로 나간다.",
  "$extensions": { "jds": { "scope": "root" } },
  "duration": {
    "$type": "duration",
    "tooltip": {
      "delay": { "$value": "350ms", "$extensions": { "jds": { "ts": "tooltipDelayMs" } } }
    }
  }
}
