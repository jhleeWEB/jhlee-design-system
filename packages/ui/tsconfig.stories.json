{
  "extends": "@buildos/typescript-config/base.json",
  "compilerOptions": {
    // 스토리·Storybook 설정·VRT 는 패키지 소스가 아니다 — 빌드 tsconfig(tsconfig.json)의 include 밖에 두고 여기서만 검사한다.
    // 안 그러면 stories 가 tsdown dts 로 새어 패키지에 실리거나(계획 §2.5-e), 소스 프로필이 storybook 타입을 요구하게 된다.
    // 엄격도는 tsconfig.json(가장 엄격한 소비자)과 같다 — 스토리는 소비자가 쓰는 방식 그대로여야 본보기가 된다.
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  },
  // `.storybook` 을 디렉터리로 적으면 TS 가 점(.)으로 시작하는 경로를 와일드카드 확장에서 건너뛰어 0파일이 된다(--listFilesOnly 실측) —
  // 파일 글롭으로 적어야 main.ts·preview.tsx 가 실제로 검사된다.
  "include": ["src/**/*.stories.tsx", "stories", ".storybook/*.ts", ".storybook/*.tsx", "vrt", "vitest.config.ts", "tsdown.config.ts"]
}
