{
  "extends": "@buildos/typescript-config/base.json",
  "compilerOptions": {
    "types": [],
    // kaufland 프로필. 이 패키지의 대부분은 구 aaro-kaufland-prototype에서 왔고 그 설정에서
    // 자랐다 — 지금 유일한 소비자도 kaufland다. 아직 엄격 목록(tsconfig.json)에 못 올린
    // 파일들이 최소한 자기가 자란 기준으로는 계속 검사되게 한다.
    "allowJs": false,
    "esModuleInterop": true
  },
  "include": ["src"],
  // 스토리는 tsconfig.stories.json 이 엄격 프로필로 검사한다 — 여기 섞이면 느슨한 프로필에 storybook 타입까지 끌려 들어온다.
  "exclude": ["src/**/*.stories.tsx"]
}
