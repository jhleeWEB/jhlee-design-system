{
  "name": "@buildos/ui",
  "version": "0.1.0",
  "private": true,
  "description": "AARO 화면 셸 — 3열 작업대(파라미터·뷰어·검사) 컴포넌트와 컨트롤, 그리고 그것이 서는 디자인 토큰.",
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./shell.css": "./src/shell.css",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app-profile.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5",
    "vitest": "^4"
  }
}
