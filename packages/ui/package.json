{
  "name": "@buildos/ui",
  "version": "0.1.0",
  "private": true,
  "description": "AARO 디자인 시스템 — 도면 캔버스와 UI 크롬을 가른 토큰(방향 C), Radix 기반 오버레이·피드백 층, 3열 작업대 셸, 그리고 그 위의 컨트롤.",
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./shell.css": "./src/shell.css",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app-profile.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "react": "^19.2.0",
    "radix-ui": "^1.6.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@buildos/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.1.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": false
    }
  }
}
