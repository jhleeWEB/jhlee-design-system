{
  "name": "@jhleeweb/squircle-design-system",
  "version": "0.1.0",
  "description": "Squircle Design System — 도면 캔버스와 UI 크롬을 가른 토큰(방향 C), Radix 기반 오버레이·피드백 층, 3열 작업대 셸, 그리고 그 위의 컨트롤. 모든 크롬 모서리는 연속 곡률(스쿼클)을 향한다.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhleeWEB/squircle-design-system.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./canvas-metrics": "./src/canvas-metrics.ts",
    "./legacy": "./src/legacy/index.ts",
    "./testing": "./src/testing/index.ts",
    "./theme.css": "./src/theme.css",
    "./corner.css": "./src/corner.css",
    "./tokens.css": "./src/tokens.css",
    "./shell.css": "./src/legacy/shell.css",
    "./canvas.css": "./src/canvas.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./canvas-metrics": {
        "types": "./dist/canvas-metrics.d.ts",
        "import": "./dist/canvas-metrics.js",
        "default": "./dist/canvas-metrics.js"
      },
      "./legacy": {
        "types": "./dist/legacy/index.d.ts",
        "import": "./dist/legacy/index.js",
        "default": "./dist/legacy/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js",
        "default": "./dist/testing/index.js"
      },
      "./theme.css": "./dist/theme.css",
      "./corner.css": "./dist/corner.css",
      "./tokens.css": "./dist/tokens.css",
      "./shell.css": "./dist/legacy/shell.css",
      "./canvas.css": "./dist/canvas.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.stories.json",
    "test": "vitest run --project=unit --project=arch --passWithNoTests",
    "tokens:build": "node tokens/build.mjs",
    "tokens:check": "node tokens/build.mjs --check",
    "test:arch": "vitest run --project=arch",
    "lint": "cd ../.. && pnpm exec eslint packages/ui --max-warnings 0",
    "test:stories": "vitest run --project=storybook",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build --test -o storybook-static",
    "vrt": "playwright test -c vrt/playwright.config.ts",
    "vrt:update": "sh ../../scripts/vrt-update.sh"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@types/react": "^19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@buildos/typescript-config": "workspace:*",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-themes": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "4.1.11",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.28",
    "postcss-value-parser": "^4.2.0",
    "publint": "^0.3.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "10.6.1",
    "style-dictionary": "^4.4.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^5",
    "vitest": "^4",
    "zod": "^4.6.5"
  }
}
