{
  "extends": "@buildos/typescript-config/base.json",
  "compilerOptions": {
    "types": [],
    // 패키지 소스는 **가장 엄격한 소비자**의 프로필 한 벌로만 검사한다(계획 §2.4 A2).
    // 예전에는 include 가 3파일 계약 목록이고 나머지를 tsconfig.app-profile.json 이 느슨하게 봤는데, 배럴(index.ts)이
    // 그 3파일에 들어 있어 실제로는 src 전량(44파일)이 이미 이 엄격 프로필을 통과하고 있었다(--listFilesOnly 실측, #11).
    // 느슨한 프로필은 하는 일이 없었으므로 지웠다 — 여기 통과하는 파일만 소비자가 어떤 tsconfig 로 import 해도 안전하다.
    // 화면 컴포넌트라 DOM 이 필요하다 — 기하 패키지의 좁은 lib 를 그대로 쓰면 이벤트 타깃이 해석되지 않는다.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    // src/eslint/ 는 루트 eslint.config.js 가 Node 24 로 빌드 없이 읽는다(type stripping) — 확장자 없는 지정자를 못 풀어 `.ts` 를 단다(#31).
    // noEmit(base) 이라 허용되고, tsdown(rolldown) 은 출력에서 `.js` 로 바꾼다.
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  // 테스트·아키텍처 가드는 tsconfig.test.json 이, 스토리는 tsconfig.stories.json 이 같은 엄격도로 검사한다.
  // 여기서 빼는 이유는 tsdown dts 가 이 tsconfig 를 읽기 때문이다 — 섞이면 스펙·스토리가 d.ts 로 새어 패키지에 실린다.
  "exclude": ["src/__tests__", "src/__arch__", "src/**/*.stories.tsx"]
}
