{
  "name": "squircle-design-system",
  "version": "0.0.0-managed",
  "private": true,
  "type": "module",
  "description": "Squircle Design System 워크스페이스 루트 — 패키지 @jhleeweb/squircle-design-system 과 Storybook 카탈로그. 버전은 semantic-release 가 관리한다.",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm --filter @jhleeweb/squircle-design-system build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"packages/ui/**/*.css\" \"packages/ui/.storybook/*.css\" --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:build": "pnpm --filter @jhleeweb/squircle-design-system tokens:build",
    "tokens:check": "pnpm --filter @jhleeweb/squircle-design-system tokens:check",
    "manifest:build": "pnpm --filter @jhleeweb/squircle-design-system manifest:build",
    "manifest:check": "pnpm --filter @jhleeweb/squircle-design-system manifest:check",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm format:check && pnpm tokens:check && pnpm manifest:check && pnpm test && pnpm build",
    "storybook": "pnpm --filter @jhleeweb/squircle-design-system storybook",
    "storybook:build": "pnpm --filter @jhleeweb/squircle-design-system storybook:build",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@buildos/eslint-rules": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@semantic-release/exec": "^7.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^25.0.9",
    "stylelint": "^17.15.0",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.16"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
  }
}
